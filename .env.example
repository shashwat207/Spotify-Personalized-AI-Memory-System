# Copy this file to .env and adjust values for your machine.
#   cp .env.example .env

# ── Neo4j (graph database) ──────────────────────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password
NEO4J_DATABASE=neo4j

# ── PostgreSQL (event store) ────────────────────────────────────
INTERACTION_API_POSTGRES_DSN=postgresql://postgres:postgres@localhost:5433/spotify_interactions

# ── API security ────────────────────────────────────────────────
INTERACTION_API_JWT_SECRET=change-me-to-a-long-random-string
INTERACTION_API_DEBUG=true
INTERACTION_API_ALLOW_DEV_AUTH_HEADER=true
INTERACTION_API_ALLOW_DEV_CONSENT_BYPASS=true

# ── Gemini (optional — chat works without it) ───────────────────
# INTERACTION_API_GEMINI_API_KEY=your-gemini-api-key
# INTERACTION_API_GEMINI_MODEL=gemini-2.5-flash

# ── Vue client (leave unset for local dev — Vite proxy handles /api) ──
# VITE_API_BASE_URL=http://localhost:8000
